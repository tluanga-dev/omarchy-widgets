#!/usr/bin/env bash
# Prints CPU stats as key=value lines. Usage is a rate, so each call diffs
# /proc/stat (and, with --top N, every /proc/<pid>/stat) against the sample
# saved by the previous call in --state <file>. The first call therefore
# reports 0% and no processes; every call after that is a real reading.
# --group merges processes that share a command name. Process percentages
# are of total machine capacity, so they add up against the headline figure.
set -uo pipefail

top=0
group=0
state="${XDG_RUNTIME_DIR:-/tmp}/dev.cpu-stats.state"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --top)   top="${2:-5}"; shift 2 ;;
    --group) group=1; shift ;;
    --state) state="$2"; shift 2 ;;
    *) shift ;;
  esac
done

ncpu=$(nproc)
read -r load1 load5 load15 _ < /proc/loadavg
model=$(awk -F': ' '/^model name/ { print $2; exit }' /proc/cpuinfo)
mhz=$(awk '/^cpu MHz/ { s += $4; n++ } END { if (n) printf "%d", s / n }' /proc/cpuinfo)

temp=""
for want in coretemp k10temp zenpower cpu_thermal acpitz; do
  for hw in /sys/class/hwmon/hwmon*; do
    [[ "$(cat "$hw/name" 2>/dev/null)" == "$want" ]] || continue
    for f in "$hw"/temp1_input "$hw"/temp*_input; do
      [[ -r "$f" ]] || continue
      temp=$(( $(cat "$f") / 1000 )); break 3
    done
  done
done

printf 'ncpu=%s\nload=%s %s %s\nmodel=%s\nmhz=%s\ntemp=%s\n' \
  "$ncpu" "$load1" "$load5" "$load15" "$model" "$mhz" "$temp"

# Current sample: the aggregate cpu line, then one line per process
# (pid, ticks, comm) when a process list was asked for. comm sits in
# parentheses and may contain spaces, so it is cut out by the last ')'.
sample=$(
  awk '/^cpu / { idle = $5 + $6; total = 0; for (i = 2; i <= NF; i++) total += $i; print "cpu\t" total "\t" idle; exit }' /proc/stat
  if (( top > 0 )); then
    for f in /proc/[0-9]*/stat; do cat "$f" 2>/dev/null; done | awk '{
      close_at = 0
      for (i = length($0); i > 0; i--) if (substr($0, i, 1) == ")") { close_at = i; break }
      if (!close_at) next
      pid = $1
      comm = substr($0, index($0, "(") + 1, close_at - index($0, "(") - 1)
      n = split(substr($0, close_at + 2), rest, " ")
      # utime and stime are fields 14 and 15 of the stat line; `rest` begins at field 3.
      print "p\t" pid "\t" (rest[12] + rest[13]) "\t" comm
    }'
  fi
)

prev=""
[[ -r "$state" ]] && prev=$(cat "$state")
printf '%s\n' "$sample" > "$state"

printf '%s\n%s\n' "$prev" "---" "$sample" | awk -F'\t' -v top="$top" -v group="$group" '
  $0 == "---" { current = 1; next }
  $1 == "cpu" { if (current) { total = $2; idle = $3 } else { ptotal = $2; pidle = $3 } next }
  $1 == "p" {
    key = $2 SUBSEP $4
    if (current) { cur[key] = $3; name[key] = $4 } else { old[key] = $3 }
  }
  END {
    dt = total - ptotal
    usage = (ptotal > 0 && dt > 0) ? (1 - (idle - pidle) / dt) * 100 : 0
    printf "pct=%d\n", int(usage + 0.5)
    if (top <= 0 || dt <= 0 || ptotal == 0) exit
    for (k in cur) {
      if (!(k in old)) continue
      d = cur[k] - old[k]
      if (d <= 0) continue
      label = group ? name[k] : k
      ticks[label] += d
      count[label]++
      lbl[label] = name[k]
    }
    for (l in ticks) printf "%.2f\t%d\t%s\n", ticks[l] / dt * 100, count[l], lbl[l] | "sort -rn | head -n " top " | sed s/^/proc=/"
  }
'
