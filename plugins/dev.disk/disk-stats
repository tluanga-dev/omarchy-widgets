#!/usr/bin/env bash
# Prints disk stats as key=value lines. Space comes from df (bytes) for every
# real filesystem; throughput is a rate, so each call diffs /proc/diskstats
# (and, with --top N, every readable /proc/<pid>/io) against the sample saved
# by the previous call in --state <file>. The first call reports 0 B/s and no
# processes. Only the caller's own processes expose /proc/<pid>/io, which is
# what matters on a desktop. --group merges processes sharing a command name.
set -uo pipefail

top=0
group=0
mount="/"
state="${XDG_RUNTIME_DIR:-/tmp}/dev.disk-stats.state"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --top)   top="${2:-5}"; shift 2 ;;
    --group) group=1; shift ;;
    --mount) mount="$2"; shift 2 ;;
    --state) state="$2"; shift 2 ;;
    *) shift ;;
  esac
done

# fs=<target>\t<size>\t<used>\t<avail>\t<source>, the bar's mount first and
# each backing device listed once.
df -B1 --output=target,size,used,avail,source \
   -x tmpfs -x devtmpfs -x efivarfs -x squashfs -x overlay -x fuse.portal -x fuse.gvfsd-fuse 2>/dev/null \
  | awk -v mount="$mount" 'NR > 1 {
      line = "fs=" $1 "\t" $2 "\t" $3 "\t" $4 "\t" $5
      if ($1 == mount) { first = line; firstSrc = $5; next }
      # btrfs subvolumes and bind mounts repeat one device: list it once.
      if ($5 in seen) next
      seen[$5] = 1
      n++; lines[n] = line; src[n] = $5
    }
    END {
      if (first != "") print first
      for (i = 1; i <= n; i++) if (src[i] != firstSrc) print lines[i]
    }'

now=${EPOCHREALTIME:-$(date +%s.%N)}

# Sample: timestamp, sectors read/written summed over whole physical disks
# (not partitions, which would double count), then per-process storage I/O.
sample=$(
  echo "t	$now"
  awk '$3 ~ /^(sd[a-z]+|nvme[0-9]+n[0-9]+|vd[a-z]+|mmcblk[0-9]+|xvd[a-z]+)$/ { r += $6; w += $10 }
       END { printf "io\t%d\t%d\n", r * 512, w * 512 }' /proc/diskstats
  if (( top > 0 )); then
    for d in /proc/[0-9]*; do
      [[ -r "$d/io" ]] || continue
      r=0; w=0
      while read -r key value; do
        case "$key" in
          read_bytes:)  r=$value ;;
          write_bytes:) w=$value ;;
        esac
      done < "$d/io" 2>/dev/null
      read -r comm < "$d/comm" 2>/dev/null || continue
      echo "p	${d#/proc/}	$((r + w))	$comm"
    done
  fi
)

prev=""
[[ -r "$state" ]] && prev=$(cat "$state")
printf '%s\n' "$sample" > "$state"

printf '%s\n%s\n' "$prev" "---" "$sample" | awk -F'\t' -v top="$top" -v group="$group" '
  $0 == "---" { current = 1; next }
  $1 == "t"  { if (current) t = $2; else pt = $2; next }
  $1 == "io" { if (current) { r = $2; w = $3 } else { pr = $2; pw = $3 } next }
  $1 == "p"  {
    key = $2 SUBSEP $4
    if (current) { cur[key] = $3; name[key] = $4 } else { old[key] = $3 }
  }
  END {
    dt = (pt > 0) ? t - pt : 0
    printf "read=%d\nwrite=%d\n", (dt > 0 ? (r - pr) / dt : 0), (dt > 0 ? (w - pw) / dt : 0)
    if (top <= 0 || dt <= 0) exit
    for (k in cur) {
      if (!(k in old)) continue
      d = cur[k] - old[k]
      if (d <= 0) continue
      label = group ? name[k] : k
      bytes[label] += d
      count[label]++
      lbl[label] = name[k]
    }
    for (l in bytes) printf "%d\t%d\t%s\n", bytes[l] / dt, count[l], lbl[l] | "sort -rn | head -n " top " | sed s/^/proc=/"
  }
'
